{
    "compilerOptions": {
        "target": "ES2025",
        "lib": ["ES2025"],
        "skipLibCheck": true,
        "module": "node20",
        "types": ["node"],

        "outDir": "build",
        "rootDir": "src/node",

        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true
    },
    "include": ["src/node", "eslint.config.mjs"]
}
